{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaperlessDb": "Host=localhost;Port=5432;Database=paperless;Username=postgres;Password=postgres"
  },
  "BatchFileService": {
    "InputFolderPath": "./batch_data/input",
    "ArchiveFolderPath": "./batch_data/archive",
    "ErrorFolderPath": "./batch_data/error",
    "FileNamePattern": "access_*.xml",
    "CronExpression": "0 1 * * *",
    "ProcessOnStartup": false,
    "TimeZone": "Europe/Vienna"
  }
}
