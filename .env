POSTGRES_DB=paperless
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CONNECTIONSTRINGS__PAPERLESSDB=Host=postgres;Port=5432;Database=paperless;Username=postgres;Password=postgres

BATCHPROCESSING__INPUTFOLDERPATH=/app/batch_input
BATCHPROCESSING__ARCHIVEFOLDERPATH=/app/batch_archive
BATCHPROCESSING__ERRORFOLDERPATH=/app/batch_error
BATCHPROCESSING__FILENAMEPATTERN=access_*.xml
BATCHPROCESSING__CRONEXPRESSION='0 1 * * *'
BATCHPROCESSING__PROCESSONSTARTUP=false
BATCHPROCESSING__TIMEZONE=Europe/Vienna
